# ==========================================
# ZEBRA - Variáveis de Ambiente para Vercel
# ==========================================

# 1. Banco de Dados na Nuvem (PostgreSQL - Neon / Supabase)
# Substitua pela URL de conexão fornecida pelo seu provedor (ex: Neon.tech ou Supabase)
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URL Direta para migrações (Opcional, usado pelo Neon/Supabase para bypass de pooler)
DIRECT_URL="postgres://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Segurança e Webhook do WhatsApp
# Token de verificação para o Webhook oficial da Meta Cloud API
WHATSAPP_VERIFY_TOKEN="zebra_verify_token_2026"

# Número de WhatsApp autorizado para lançamentos (com DDI e DDD, ex: 5511999999999)
AUTHORIZED_PHONE="5511999999999"

# 3. URL Pública da Aplicação (Configurada automaticamente na Vercel ou personalizada)
NEXT_PUBLIC_APP_URL="https://zebra-finance.vercel.app"

# 4. Senha Mestra de Acesso ao Painel (Proteção de Acesso Pessoal)
APP_PASSWORD="sua_senha_mestra_secreta"

# 5. Configuração da Evolution API (Para resposta automática no WhatsApp)
EVOLUTION_API_URL="https://sua-evolution-api.com"
EVOLUTION_API_KEY="seu_token_de_autenticacao_da_evolution"
EVOLUTION_INSTANCE_NAME="zebra"

# 6. (Opcional) Chave de IA para áudios ou linguagem natural complexa
# GEMINI_API_KEY="AIzaSy..."


